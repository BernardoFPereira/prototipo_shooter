code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, depth_prepass_alpha, unshaded;

uniform float Bits = 16;
uniform sampler2D tex_frg_6;



void fragment() {
// Input:5
	vec4 n_out5p0 = COLOR;


// Input:7
	vec2 n_out7p0 = UV;


// FloatParameter:11
	float n_out11p0 = Bits;


// VectorOp:9
	vec4 n_out9p0 = vec4(n_out7p0, 0.0, 0.0) * vec4(n_out11p0);


// VectorFunc:8
	vec4 n_out8p0 = round(n_out9p0);


// VectorOp:10
	vec4 n_out10p0 = n_out8p0 / vec4(n_out11p0);


// Texture2D:6
	vec4 n_out6p0 = texture(tex_frg_6, vec2(n_out10p0.xy));


// VectorOp:4
	vec4 n_out4p0 = n_out5p0 * n_out6p0;


// VectorDecompose:12
	float n_out12p0 = n_out5p0.x;
	float n_out12p1 = n_out5p0.y;
	float n_out12p2 = n_out5p0.z;
	float n_out12p3 = n_out5p0.w;


// VectorOp:13
	vec4 n_out13p0 = vec4(n_out12p3) * n_out6p0;


// Output:0
	ALBEDO = vec3(n_out4p0.xyz);
	ALPHA = n_out13p0.x;


}
"
