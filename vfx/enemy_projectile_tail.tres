code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D Tail_Color : source_color;
uniform float Bits = 32;
uniform sampler2D tex_frg_2 : source_color;
uniform sampler2D tex_frg_6 : source_color;



void fragment() {
// Input:8
	vec4 n_out8p0 = COLOR;


	vec4 n_out12p0;
// Texture2D:12
	n_out12p0 = texture(Tail_Color, UV);


// VectorOp:11
	vec4 n_out11p0 = n_out8p0 * n_out12p0;


// Input:13
	vec2 n_out13p0 = UV;


// FloatParameter:17
	float n_out17p0 = Bits;


// VectorOp:14
	vec4 n_out14p0 = vec4(n_out13p0, 0.0, 0.0) * vec4(n_out17p0);


// VectorFunc:15
	vec4 n_out15p0 = round(n_out14p0);


// VectorOp:16
	vec4 n_out16p0 = n_out15p0 / vec4(n_out17p0);


// Input:4
	float n_out4p0 = TIME;


// UVFunc:3
	vec2 n_in3p1 = vec2(4.00000, 0.00000);
	vec2 n_out3p0 = vec2(n_out4p0) * n_in3p1 + vec2(n_out16p0.xy);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out3p0);


// VectorOp:7
	vec4 n_out7p0 = n_out11p0 * n_out2p0;


// Texture2D:6
	vec4 n_out6p0 = texture(tex_frg_6, UV);


// FloatOp:20
	float n_out20p0 = n_out2p0.x - n_out6p0.x;


// Clamp:19
	float n_in19p1 = 0.00000;
	float n_in19p2 = 1.00000;
	float n_out19p0 = clamp(n_out20p0, n_in19p1, n_in19p2);


// Output:0
	ALBEDO = vec3(n_out7p0.xyz);
	ALPHA = n_out19p0;


}
"
