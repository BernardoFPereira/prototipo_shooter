[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float Bits = 24;
uniform sampler2D tex_frg_2 : source_color;
uniform sampler2D tex_frg_3 : source_color;



void fragment() {
// ColorParameter:9
	vec4 n_out9p0 = ColorParameter;


// Input:12
	vec2 n_out12p0 = UV;


// FloatParameter:16
	float n_out16p0 = Bits;


// VectorOp:14
	vec4 n_out14p0 = vec4(n_out12p0, 0.0, 0.0) * vec4(n_out16p0);


// VectorFunc:13
	vec4 n_out13p0 = round(n_out14p0);


// VectorOp:15
	vec4 n_out15p0 = n_out13p0 / vec4(n_out16p0);


// Input:6
	float n_out6p0 = TIME;


// UVFunc:5
	vec2 n_in5p1 = vec2(0.00000, -1.50000);
	vec2 n_out5p0 = vec2(n_out6p0) * n_in5p1 + vec2(n_out15p0.xy);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out5p0);


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, UV);


// FloatOp:10
	float n_out10p0 = n_out2p0.x - n_out3p0.x;


// Clamp:11
	float n_in11p1 = 0.00000;
	float n_in11p2 = 1.00000;
	float n_out11p0 = clamp(n_out10p0, n_in11p1, n_in11p2);


// Output:0
	ALBEDO = vec3(n_out9p0.xyz);
	ALPHA = n_out11p0;


}
