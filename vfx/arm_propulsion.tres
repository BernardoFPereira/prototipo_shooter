[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 PanSpeed = vec2(0.000000, 1.000000);
uniform sampler2D tex_vtx_2 : source_color;
uniform float CurveIntensity = 0.10000000149012;
uniform float Bits = 24;
uniform sampler2D tex_frg_6 : source_color;
uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform sampler2D tex_frg_2 : source_color;



void vertex() {
// Input:3
	vec3 n_out3p0 = VERTEX;


// Input:12
	vec3 n_out12p0 = NORMAL;


// Input:6
	float n_out6p0 = TIME;


// Vector2Parameter:8
	vec2 n_out8p0 = PanSpeed;


// VectorOp:9
	vec2 n_out9p0 = vec2(n_out6p0) * n_out8p0;


// UVFunc:5
	vec2 n_in5p1 = vec2(1.00000, -1.00000);
	vec2 n_out5p0 = n_out9p0 * n_in5p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_vtx_2, n_out5p0);


// FloatParameter:10
	float n_out10p0 = CurveIntensity;


// FloatOp:11
	float n_out11p0 = n_out2p0.x * n_out10p0;


// VectorOp:4
	vec3 n_out4p0 = n_out12p0 * vec3(n_out11p0);


// VectorOp:13
	vec3 n_out13p0 = n_out3p0 + n_out4p0;


// Output:0
	VERTEX = n_out13p0;


}

void fragment() {
// Input:11
	vec2 n_out11p0 = UV;


// FloatParameter:14
	float n_out14p0 = Bits;


// VectorOp:13
	vec4 n_out13p0 = vec4(n_out11p0, 0.0, 0.0) * vec4(n_out14p0);


// VectorFunc:12
	vec4 n_out12p0 = round(n_out13p0);


// VectorOp:15
	vec4 n_out15p0 = n_out12p0 / vec4(n_out14p0);


// Input:10
	float n_out10p0 = TIME;


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, -1.00000);
	vec2 n_out9p0 = vec2(n_out10p0) * n_in9p1 + vec2(n_out15p0.xy);


// Texture2D:6
	vec4 n_out6p0 = texture(tex_frg_6, n_out9p0);


// ColorParameter:7
	vec4 n_out7p0 = ColorParameter;


// VectorOp:8
	vec4 n_out8p0 = n_out6p0 * n_out7p0;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// Output:0
	ALBEDO = vec3(n_out8p0.xyz);
	ALPHA = n_out2p0.x;


}
