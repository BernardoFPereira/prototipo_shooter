code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform float Bits = 6;
uniform sampler2D tex_frg_16 : source_color;



void vertex() {
	mat4 n_out2p0;
// GetBillboardMatrix:2
	{
		mat4 __mvm = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], MODEL_MATRIX[1], vec4(normalize(cross(INV_VIEW_MATRIX[0].xyz, MODEL_MATRIX[1].xyz)), 0.0), MODEL_MATRIX[3]);
		__mvm = __mvm * mat4(vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0), vec4(0.0, 1.0, 0.0, 0.0), vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0), vec4(0.0, 0.0, 0.0, 1.0));
		n_out2p0 = __mvm;
	}


// Output:0
	MODELVIEW_MATRIX = n_out2p0;


}

void fragment() {
// Input:17
	vec4 n_out17p0 = COLOR;


// Input:11
	vec2 n_out11p0 = UV;


// FloatParameter:15
	float n_out15p0 = Bits;


// VectorOp:12
	vec4 n_out12p0 = vec4(n_out11p0, 0.0, 0.0) * vec4(n_out15p0);


// VectorFunc:13
	vec4 n_out13p0 = round(n_out12p0);


// VectorOp:14
	vec4 n_out14p0 = n_out13p0 / vec4(n_out15p0);


// Texture2D:16
	vec4 n_out16p0 = texture(tex_frg_16, vec2(n_out14p0.xy));


// VectorOp:18
	vec4 n_out18p0 = n_out17p0 * n_out16p0;


// VectorDecompose:19
	float n_out19p0 = n_out17p0.x;
	float n_out19p1 = n_out17p0.y;
	float n_out19p2 = n_out17p0.z;
	float n_out19p3 = n_out17p0.w;


// VectorOp:20
	vec4 n_out20p0 = vec4(n_out19p3) * n_out16p0;


// Output:0
	ALBEDO = vec3(n_out18p0.xyz);
	ALPHA = n_out20p0.x;


}
