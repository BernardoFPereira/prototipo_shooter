code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 UV_Pan_Speed = vec2(0.000000, 1.000000);
uniform sampler2D tex_vtx_3;
uniform float Curve_Intensity : hint_range(0, 5) = 1;
uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_3;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:4
	vec3 n_out4p0 = NORMAL;


// Input:8
	float n_out8p0 = TIME;


// Vector2Parameter:12
	vec2 n_out12p0 = UV_Pan_Speed;


// VectorOp:9
	vec2 n_out9p0 = vec2(n_out8p0) * n_out12p0;


// UVFunc:7
	vec2 n_in7p1 = vec2(1.00000, 1.00000);
	vec2 n_out7p0 = n_out9p0 * n_in7p1 + UV;


// Texture2D:3
	vec4 n_out3p0 = texture(tex_vtx_3, n_out7p0);


// FloatParameter:10
	float n_out10p0 = Curve_Intensity;


// FloatOp:11
	float n_out11p0 = n_out3p0.x * n_out10p0;


// VectorOp:6
	vec3 n_out6p0 = n_out4p0 * vec3(n_out11p0);


// VectorOp:5
	vec3 n_out5p0 = n_out2p0 + n_out6p0;


// Output:0
	VERTEX = n_out5p0;


}

void fragment() {
// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, vec2(n_out2p0.xy));


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);


}
